{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winst-dt.local/schemas/c2_static_prior.schema.json",
  "type": "object",
  "required": ["schema_version", "sample_sha256", "capa_capabilities", "iocs", "family_attribution", "source_artifacts", "extraction_warnings"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capa_capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "iocs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "value", "provenance"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["ip", "domain", "url", "email", "hash"]},
          "value": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "required": ["source_path", "source_sha256"],
            "properties": {
              "source_path": {"type": "string"},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": true
          }
        }
      }
    },
    "family_attribution": {
      "type": ["object", "null"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "required": ["family", "evidence"],
      "additionalProperties": false
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "extraction_warnings": {"type": "array", "items": {"type": "string"}}
  }
}
