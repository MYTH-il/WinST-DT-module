{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://winst-dt.local/schemas/c2_provenance.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","task_id","sample_sha256","pcap_sha256","upstream_repository","upstream_commit","compatibility_patch_hashes","effective_runtime_tree_sha256","dependency_lock_sha256","input_hashes","handoff_hashes","correlation_mode","zeek","feed_revisions","database_schema_version","fixture_usage","started_at_utc","ended_at_utc","warnings","degraded_features","optional_inputs","stages"],
  "properties":{"schema_version":{"const":"1.0"},"task_id":{"type":"integer","minimum":1},"sample_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"pcap_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"upstream_repository":{"type":"string"},"upstream_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"compatibility_patch_hashes":{"type":"array","minItems":1,"items":{"type":"object","required":["name","sha256"]}},"effective_runtime_tree_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"dependency_lock_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"input_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"handoff_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"correlation_mode":{"enum":["host_network","network_only"]},"zeek":{"type":"object","required":["zeek_mode","limitations","generated_files","input_pcap_sha256"]},"feed_revisions":{"type":"array"},"database_schema_version":{"type":"integer","minimum":1},"fixture_usage":{"type":"boolean"},"started_at_utc":{"type":"string","format":"date-time"},"ended_at_utc":{"type":"string","format":"date-time"},"warnings":{"type":"array"},"degraded_features":{"type":"array"},"optional_inputs":{"type":"object","minProperties":1,"additionalProperties":{"enum":["available","disabled","not_available","invalid"]}},"stages":{"type":"object","minProperties":1,"additionalProperties":{"enum":["complete","degraded","not_available","failed"]}}}
}
