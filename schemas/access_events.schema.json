{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winst-dt.local/schemas/access_events.schema.json",
  "title": "C2 Analyzer Host Access Events",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["timestamp", "data_type", "api_call"],
    "additionalProperties": false,
    "properties": {
      "timestamp": {"type":"string", "format":"date-time"},
      "data_type": {"type":"string", "enum":["browser_credentials","keystrokes","screenshot","clipboard","crypto_wallet","system_info","file_access"]},
      "api_call": {"type":"string", "minLength":1},
      "process": {"type":["string","null"]}
    }
  }
}
