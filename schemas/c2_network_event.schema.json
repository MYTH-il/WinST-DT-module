{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winst-dt.local/schemas/c2_network_event.schema.json",
  "type": "object",
  "required": ["event_id", "task_id", "sample_id", "pcap_sha256", "session_id", "cape_task_id", "timestamp", "confidence_tier", "stage_status"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "integer", "minimum": 1},
    "sample_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pcap_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "session_id": {"type": "string", "minLength": 1},
    "cape_task_id": {"type": "integer", "minimum": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "confidence_tier": {"enum": ["confirmed", "strong", "weak", "unconfirmed", "allowlisted"]},
    "stage_status": {"enum": ["complete", "degraded", "not_available", "failed"]},
    "destination_domain": {"type": ["string", "null"]},
    "asn_org": {"type": ["string", "null"]},
    "reputation_note": {"type": ["string", "null"]},
    "reputation_source": {"type": ["string", "null"]},
    "network_mode": {"enum": ["simulated_inetsim", "live_egress"]},
    "handshake_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "beacon_note": {"type": "string"},
    "dns_evidence": {"type": "string"},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
