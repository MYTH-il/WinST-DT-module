{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://winst-dt.local/schemas/c2_network_event.schema.json",
  "type":"object",
  "required":["event_id","task_id","sample_id","pcap_sha256","timestamp","confidence_tier","stage_status"],
  "properties":{"event_id":{"type":"string","minLength":1},"task_id":{"type":"integer","minimum":1},"sample_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},"pcap_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"timestamp":{"type":"string","format":"date-time"},"confidence_tier":{"enum":["confirmed","strong","weak","unconfirmed","allowlisted"]},"stage_status":{"enum":["complete","degraded","not_available","failed"]}},
  "additionalProperties":true
}
