diff --git a/sql/migrations/001_baseline.sql b/sql/migrations/001_baseline.sql
new file mode 100644
index 0000000..b046605
--- /dev/null
+++ b/sql/migrations/001_baseline.sql
@@ -0,0 +1,12 @@
+BEGIN;
+CREATE TABLE IF NOT EXISTS schema_versions (
+  component  TEXT PRIMARY KEY,
+  version    INTEGER NOT NULL CHECK (version > 0),
+  applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+INSERT INTO schema_versions(component, version)
+SELECT 'c2-exfil', 1
+WHERE NOT EXISTS (
+  SELECT 1 FROM schema_versions WHERE component = 'c2-exfil'
+);
+COMMIT;
diff --git a/sql/migrations/002_winstdt_compat.sql b/sql/migrations/002_winstdt_compat.sql
new file mode 100644
index 0000000..2e1f58c
--- /dev/null
+++ b/sql/migrations/002_winstdt_compat.sql
@@ -0,0 +1,39 @@
+BEGIN;
+SELECT pg_advisory_xact_lock(hashtext('winstdt-c2-schema'));
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS destination_domain TEXT;
+UPDATE samples SET confidence_tier = 'unconfirmed'
+ WHERE confidence_tier NOT IN ('confirmed','strong','weak','unconfirmed','allowlisted');
+UPDATE exfil_events SET confidence_tier = 'unconfirmed'
+ WHERE confidence_tier IS NOT NULL
+   AND confidence_tier NOT IN ('confirmed','strong','weak','unconfirmed','allowlisted');
+ALTER TABLE samples DROP CONSTRAINT IF EXISTS samples_confidence_tier_check;
+ALTER TABLE samples ADD CONSTRAINT samples_confidence_tier_check
+ CHECK (confidence_tier IN ('confirmed','strong','weak','unconfirmed','allowlisted'));
+ALTER TABLE exfil_events DROP CONSTRAINT IF EXISTS exfil_events_confidence_tier_check;
+ALTER TABLE exfil_events ADD CONSTRAINT exfil_events_confidence_tier_check
+ CHECK (confidence_tier IS NULL OR confidence_tier IN
+   ('confirmed','strong','weak','unconfirmed','allowlisted'));
+ALTER TABLE exfil_events DROP CONSTRAINT IF EXISTS exfil_events_confidence_score_check;
+ALTER TABLE exfil_events ADD CONSTRAINT exfil_events_confidence_score_check
+ CHECK (confidence_score IS NULL OR (confidence_score >= 0 AND confidence_score <= 1));
+CREATE TABLE IF NOT EXISTS attributions (
+  sample_id TEXT NOT NULL REFERENCES samples(sample_id),
+  family TEXT NOT NULL,
+  confidence TEXT NOT NULL CHECK (confidence IN ('confirmed','likely','possible')),
+  basis TEXT NOT NULL CHECK (basis IN ('static_prior','threat_intel','behavioural')),
+  evidence JSONB NOT NULL CHECK (jsonb_typeof(evidence) = 'array'),
+  PRIMARY KEY (sample_id, family)
+);
+CREATE TABLE IF NOT EXISTS result_provenance (
+  sample_id TEXT PRIMARY KEY REFERENCES samples(sample_id),
+  analysis_id TEXT,
+  pcap_sha256 TEXT NOT NULL,
+  provenance JSONB NOT NULL,
+  loaded_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+CREATE INDEX IF NOT EXISTS idx_exfil_domain ON exfil_events(destination_domain);
+INSERT INTO schema_versions(component, version)
+VALUES ('c2-exfil', 2)
+ON CONFLICT (component) DO UPDATE SET version = EXCLUDED.version,
+ applied_at = now();
+COMMIT;
diff --git a/sql/migrations/003_upstream_1_2.sql b/sql/migrations/003_upstream_1_2.sql
new file mode 100644
index 0000000..a7c9e84
--- /dev/null
+++ b/sql/migrations/003_upstream_1_2.sql
@@ -0,0 +1,22 @@
+BEGIN;
+SELECT pg_advisory_xact_lock(hashtext('winstdt-c2-schema'));
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS session_id TEXT;
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS cape_task_id INTEGER;
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS asn_org TEXT;
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS reputation_note TEXT;
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS reputation_source TEXT;
+ALTER TABLE exfil_events ADD COLUMN IF NOT EXISTS manifest_sha256 TEXT;
+ALTER TABLE exfil_events DROP CONSTRAINT IF EXISTS exfil_events_cape_task_id_check;
+ALTER TABLE exfil_events ADD CONSTRAINT exfil_events_cape_task_id_check
+ CHECK (cape_task_id IS NULL OR cape_task_id > 0);
+ALTER TABLE exfil_events DROP CONSTRAINT IF EXISTS exfil_events_manifest_sha256_check;
+ALTER TABLE exfil_events ADD CONSTRAINT exfil_events_manifest_sha256_check
+ CHECK (manifest_sha256 IS NULL OR manifest_sha256 ~ '^[0-9a-f]{64}$');
+CREATE INDEX IF NOT EXISTS idx_exfil_session ON exfil_events(session_id);
+CREATE INDEX IF NOT EXISTS idx_exfil_cape_task ON exfil_events(cape_task_id);
+CREATE INDEX IF NOT EXISTS idx_exfil_manifest ON exfil_events(manifest_sha256);
+INSERT INTO schema_versions(component, version)
+VALUES ('c2-exfil', 3)
+ON CONFLICT (component) DO UPDATE SET version = EXCLUDED.version,
+ applied_at = now();
+COMMIT;
diff --git a/sql/schema.sql b/sql/schema.sql
index bf96749..21ff366 100644
--- a/sql/schema.sql
+++ b/sql/schema.sql
@@ -1,6 +1,12 @@
 -- Shared cross-module schema. All modules (Windows ST/DT, Windows C2/Exfil,
 -- Android) write here. This file is the single source of truth for the contract.
 
+CREATE TABLE IF NOT EXISTS schema_versions (
+  component  TEXT PRIMARY KEY,
+  version    INTEGER NOT NULL CHECK (version > 0),
+  applied_at TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
 CREATE TABLE IF NOT EXISTS samples (
   sample_id        TEXT PRIMARY KEY,          -- sha256
   platform         TEXT NOT NULL,             -- 'windows' | 'android'
@@ -52,5 +58,31 @@ CREATE TABLE IF NOT EXISTS evidence_log (
   timestamp     TIMESTAMPTZ NOT NULL DEFAULT now()
 );
 
+CREATE TABLE IF NOT EXISTS attributions (
+  sample_id   TEXT NOT NULL REFERENCES samples(sample_id),
+  family      TEXT NOT NULL,
+  confidence  TEXT NOT NULL CHECK (confidence IN ('confirmed','likely','possible')),
+  basis       TEXT NOT NULL CHECK (basis IN ('static_prior','threat_intel','behavioural')),
+  evidence    JSONB NOT NULL CHECK (jsonb_typeof(evidence) = 'array'),
+  PRIMARY KEY (sample_id, family)
+);
+
+CREATE TABLE IF NOT EXISTS result_provenance (
+  sample_id        TEXT PRIMARY KEY REFERENCES samples(sample_id),
+  analysis_id      TEXT,
+  pcap_sha256      TEXT NOT NULL,
+  provenance       JSONB NOT NULL,
+  loaded_at        TIMESTAMPTZ NOT NULL DEFAULT now()
+);
+
+INSERT INTO schema_versions(component, version)
+VALUES ('c2-exfil', 3)
+ON CONFLICT (component) DO UPDATE SET version = EXCLUDED.version,
+  applied_at = now();
+
 CREATE INDEX IF NOT EXISTS idx_exfil_sample ON exfil_events(sample_id);
 CREATE INDEX IF NOT EXISTS idx_exfil_dstip  ON exfil_events(destination_ip);
+CREATE INDEX IF NOT EXISTS idx_exfil_domain ON exfil_events(destination_domain);
+CREATE INDEX IF NOT EXISTS idx_exfil_session ON exfil_events(session_id);
+CREATE INDEX IF NOT EXISTS idx_exfil_cape_task ON exfil_events(cape_task_id);
+CREATE INDEX IF NOT EXISTS idx_exfil_manifest ON exfil_events(manifest_sha256);
